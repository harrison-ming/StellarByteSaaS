# /etc/nginx/sites-available/stellarpostiz (+ symlink in sites-enabled). Spec 5.3.
# Name sorts after "listmonk", so the host's default (fallback) server block is unchanged.
# Cloudflare (proxied, SSL mode Full (strict) for this hostname only, via a Configuration Rule)
# -> this host :443 with a Let's Encrypt cert for app.stellarbyte.ca (certbot dns-cloudflare,
# auto-renewed by certbot.timer, deploy hook renewal-hooks/deploy/nginx-app-stellarbyte.sh
# reloads nginx) -> 127.0.0.1:4007 = nginx inside stellarbyte-app (:5000), which routes
# /api -> backend :3000 and everything else -> frontend :4200.
# Real client IP: nginx.conf (http level) already has set_real_ip_from <Cloudflare ranges> +
# real_ip_header CF-Connecting-IP, so $binary_remote_addr below is the visitor IP, not Cloudflare's.
# X-Forwarded-For is overwritten with that IP (not appended), so a client-sent X-Forwarded-For
# never reaches the app.
#
# Security headers: nginx.conf sets 4 global add_header lines; any add_header in this server block
# REPLACES (does not extend) the inherited ones, so all of them are restated here. Changes vs
# global: HSTS 1 year (includeSubDomains covers only *.app.stellarbyte.ca, no preload), plus
# Permissions-Policy. The app is
# never framed by itself (it only embeds youtube.com), so SAMEORIGIN is safe.

# Login brute-force protection (auth endpoints only): 10 req/min per visitor IP, burst 5.
limit_req_zone $binary_remote_addr zone=stellarbyte_auth:10m rate=10r/m;

map $http_upgrade $stellarbyte_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen 443 ssl;
    server_name app.stellarbyte.ca;

    ssl_certificate /etc/letsencrypt/live/app.stellarbyte.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.stellarbyte.ca/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Baseline CSP: only directives that cannot break the Next.js bundle (no script-src yet,
    # the app relies on inline scripts). Blocks framing by other sites, <base> hijacking and plugins.
    add_header Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;

    # Framework fingerprint (Next.js / Express) is not needed by any client.
    proxy_hide_header X-Powered-By;

    # Cloudflare free plan caps request bodies at 100 MB.
    client_max_body_size 100m;

    # HTTPS everywhere (spec 8.4) without touching zone settings: Cloudflare (SSL Full) always
    # pulls over 443 and reports the visitor scheme in X-Forwarded-Proto.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # RFC 9116 contact for vulnerability reports.
    location = /.well-known/security.txt {
        default_type text/plain;
        return 200 "Contact: mailto:support@stellarbyte.ca\nExpires: 2027-11-21T00:00:00Z\nPreferred-Languages: en, zh\nCanonical: https://app.stellarbyte.ca/.well-known/security.txt\n";
    }

    # Unauthenticated auth endpoints (backend routes /auth/* behind the container's /api prefix).
    # Express matches routes case-insensitively and ignores a trailing slash, so the match here
    # must too (~* plus optional "/..."), otherwise /api/auth/login/ or /API/auth/Login skip the limit.
    location ~* ^/api/auth/(login|register|forgot|forgot-return|activate|resend-activation)(/.*)?$ {
        limit_req zone=stellarbyte_auth burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Cloudflare always reaches the user over HTTPS; keep cookies "secure" even on :80 origin pulls.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stellarbyte_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
