# /etc/nginx/sites-available/stellarpostiz (+ symlink in sites-enabled). Spec 5.3.
# Name sorts after "listmonk", so the host's default (fallback) server block is unchanged.
# Cloudflare (proxied, SSL mode Full) -> this host :443 with the self-signed *.stellarbyte.ca
# origin cert -> 127.0.0.1:4007 = nginx inside stellarbyte-app (:5000), which routes
# /api -> backend :3000 and everything else -> frontend :4200.
# Real client IP: nginx.conf (http level) already has set_real_ip_from <Cloudflare ranges> +
# real_ip_header CF-Connecting-IP, so $binary_remote_addr below is the visitor IP, not Cloudflare's.
#
# Security headers: nginx.conf sets 4 global add_header lines; any add_header in this server block
# REPLACES (does not extend) the inherited ones, so all of them are restated here. Changes vs
# global: HSTS 6 months without includeSubDomains/preload, plus Permissions-Policy. The app is
# never framed by itself (it only embeds youtube.com), so SAMEORIGIN is safe.

# Login brute-force protection (auth endpoints only): 10 req/min per visitor IP, burst 5.
limit_req_zone $binary_remote_addr zone=stellarbyte_auth:10m rate=10r/m;

map $http_upgrade $stellarbyte_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen 443 ssl;
    server_name app.stellarbyte.ca;

    ssl_certificate /etc/ssl/certs/origin.crt;
    ssl_certificate_key /etc/ssl/private/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    # Cloudflare free plan caps request bodies at 100 MB.
    client_max_body_size 100m;

    # HTTPS everywhere (spec 8.4) without touching zone settings: Cloudflare (SSL Full) always
    # pulls over 443 and reports the visitor scheme in X-Forwarded-Proto.
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }

    # Unauthenticated auth endpoints (backend routes /auth/* behind the container's /api prefix).
    location ~ ^/api/auth/(login|register|forgot|forgot-return|activate|resend-activation)$ {
        limit_req zone=stellarbyte_auth burst=5 nodelay;
        limit_req_status 429;
        limit_req_log_level warn;
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:4007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Cloudflare always reaches the user over HTTPS; keep cookies "secure" even on :80 origin pulls.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $stellarbyte_connection_upgrade;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_request_buffering off;
    }
}
