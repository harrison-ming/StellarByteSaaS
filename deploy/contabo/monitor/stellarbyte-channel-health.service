# /etc/systemd/system/stellarbyte-channel-health.service (docs/DEPLOYMENT.md 12.3).
# Fails (Discord alert on first failure and on recovery) when a channel needs a
# reconnect, a token without refresh is about to expire, a post failed, or a queued
# post is overdue. Script: /usr/local/sbin/stellarbyte-channel-health.sh
[Unit]
Description=StellarByte channel and publishing health check
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/notify-command-status.sh --name stellarbyte-channel-health -- /usr/local/sbin/stellarbyte-channel-health.sh
User=root
Group=root
UMask=0077
StateDirectory=stellarmail-command-status
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
