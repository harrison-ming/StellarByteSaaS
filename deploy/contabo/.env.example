# StellarByte production environment (L3 of docs/redeploy-spec.md section 3).
# Template only: real values live in STELLAR CONFIG/StellarByteSaaS/.env.production
# (master copy) and /opt/stellarpostiz/.env on Contabo (chmod 600). Never commit values.
# Every secret below must be newly generated (spec 5.6); do NOT reuse old 107-era values.

# ---------------------------------------------------------------- core / URLs
MAIN_URL="https://app.stellarbyte.ca"
FRONTEND_URL="https://app.stellarbyte.ca"
# Absolute public API URL. Must NOT be relative: the backend parses it with new URL()
# (libraries/nestjs-libraries/src/chat/start.mcp.ts) and crashes on "/api" (phase 2 finding).
# Same origin as the frontend; nginx inside the image routes /api -> backend :3000.
NEXT_PUBLIC_BACKEND_URL="https://app.stellarbyte.ca/api"
BACKEND_INTERNAL_URL="http://localhost:3000"
IS_GENERAL="true"
# openssl rand -hex 48
JWT_SECRET=""
NOT_SECURED=""

# ---------------------------------------------------------------- compose stack (docker-compose.yml)
# This file doubles as compose interpolation input and the app env_file. The compose file
# builds DATABASE_URL / REDIS_URL from the passwords below and blanks them inside the app.
# Image tag pushed by CI (spec 8.1), e.g. stellarbyte-v2.25.3-r2
STELLARBYTE_TAG=""
# Host port bound on 127.0.0.1 only (nginx site stellarpostiz proxies to it). Not 8080/9000.
STELLARBYTE_HTTP_PORT="4007"
# Postgres 17 container, separate databases for the app and Temporal (D4).
# Each: openssl rand -hex 24   (hex only: they are embedded in connection URLs)
POSTGRES_SUPERUSER_PASSWORD=""
STELLARBYTE_DB_PASSWORD=""
TEMPORAL_DB_PASSWORD=""
REDIS_PASSWORD=""

# ---------------------------------------------------------------- Temporal (D2, D3)
# TEMPORAL_ADDRESS / TEMPORAL_NAMESPACE are fixed in docker-compose.yml (temporal:7233 / default).
# Required: without it missingPostWorkflow never starts and missed posts are not retried.
RUN_CRON="true"

# ---------------------------------------------------------------- access (D11, D10)
# true = only the very first organization can register; everyone else is refused.
# Verified in v2.25.3: apps/backend/src/services/auth/auth.service.ts canRegister(),
# apps/frontend/src/proxy.ts and app/(app)/auth/page.tsx.
DISABLE_REGISTRATION="true"
# LinkedIn company pages are out of scope (spec section 1); hidden from the add-channel screen.
# Append facebook,instagram,instagram-standalone if the Meta apps stay restricted.
HIDDEN_PROVIDERS="linkedin-page"
# The "Agents / Dev" and "Apps" settings tabs (org API key, MCP, OAuth apps) are only shown
# to the instance super-admin. Grant it once after the first user registers:
#   UPDATE "User" SET "isSuperAdmin" = true WHERE email = '<admin email>';

# ---------------------------------------------------------------- email (spec 5.4)
# Stalwart submission on 587 STARTTLS, relayed out through SES. Containers never use port 25.
EMAIL_PROVIDER="nodemailer"
EMAIL_HOST="mx.stellarbyte.ca"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="<stalwart principal name>"
EMAIL_PASS=""
EMAIL_FROM_ADDRESS="app-noreply@stellarbyte.ca"
EMAIL_FROM_NAME="StellarByte"

# ---------------------------------------------------------------- media storage (D15)
STORAGE_PROVIDER="cloudflare"
CLOUDFLARE_ACCOUNT_ID=""
# R2 token scoped to the stellar-postiz bucket only.
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME="stellar-postiz"
CLOUDFLARE_BUCKET_URL="https://media.stellarbyte.ca/"
CLOUDFLARE_REGION="auto"

# ---------------------------------------------------------------- providers in scope (spec section 1)
# Bitwarden: Pinterest c5fd1a75-..., LinkedIn c1153ce7-..., Google/YouTube cfc8d358-... (HOST DEV)
# Redirect URIs: https://app.stellarbyte.ca/integrations/social/<provider>
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# ---------------------------------------------------------------- telemetry: MUST stay unset (spec 3.4)
# Each of these turns on an outbound call to Postiz / third-party analytics:
#   DATAFAST_WEBSITE_ID      -> datafa.st script with data-domain="postiz.com"
#   STRIPE_PUBLISHABLE_KEY   -> also enables Plausible (domain postiz.com) and Dub (refer postiz.pro)
#   NEXT_PUBLIC_GTM_ID, NEXT_PUBLIC_TRACKING_TRIAL -> Google Tag Manager / Ads
#   NEXT_PUBLIC_FACEBOOK_PIXEL -> Meta pixel
#   NEXT_PUBLIC_SENTRY_DSN   -> Sentry
#   CHATBASE_TOKEN, NEXT_PUBLIC_DISCORD_SUPPORT -> support widgets
# Billing is out of scope, so all Stripe variables stay unset as well.
DATAFAST_WEBSITE_ID=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_FACEBOOK_PIXEL=""
NEXT_PUBLIC_SENTRY_DSN=""
CHATBASE_TOKEN=""
NEXT_PUBLIC_DISCORD_SUPPORT=""

# ---------------------------------------------------------------- misc
API_LIMIT=30
NX_ADD_PLUGINS=false
